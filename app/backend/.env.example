# Copy this file to backend/.env and fill in the values.
# backend/.env is ignored by git. Do not share these values.

# PostgreSQL. The app uses the runtime role. Migrations use the admin role.
# Create both roles and the database first. See the deployment plan.
DATABASE_URL=postgres://raindrop_app:CHANGE_ME@127.0.0.1:5432/raindrop
DATABASE_ADMIN_URL=postgres://raindrop_admin:CHANGE_ME@127.0.0.1:5432/raindrop

# Tests. Use a database where both roles exist. Tests skip when these are not set.
# TEST_DATABASE_URL=postgres://raindrop_app:CHANGE_ME@127.0.0.1:5432/raindrop
# TEST_DATABASE_ADMIN_URL=postgres://raindrop_admin:CHANGE_ME@127.0.0.1:5432/raindrop

# Raindrop app (App Management Console). One pair for the whole app, not per user.
RAINDROP_CLIENT_ID=
RAINDROP_CLIENT_SECRET=
# Optional. Must match the redirect URL registered in the Raindrop app.
# RAINDROP_REDIRECT_URI=http://127.0.0.1:8100/oauth/callback

# LLM endpoint (OpenAI-compatible) used for folder and tag suggestions.
# API_Endpoint is the base URL with its version path, for example https://<host>/v1.
# The app adds /chat/completions. Check it with GET <API_Endpoint>/models and the token.
API_Endpoint=
token=
llm_model=
